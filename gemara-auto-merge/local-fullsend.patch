+package repos
+
+import (
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+	"testing"
+)
+
+func TestManifestAutoMergeInheritance(t *testing.T) {
+	var m Manifest
+	require.NoError(t, yaml.Unmarshal([]byte(`version: 1
+defaults:
+  config:
+    auto_merge:
+      mode: shadow
+      policy: fullsend-default
+      controls: [OSPS-QA-03.01]
+github:
+  repos:
+    - name: example/api
+      config:
+        auto_merge:
+          mode: off
+    - name: example/docs
+`), &m))
+	first, ok := m.ResolveConfig("example", "api")
+	require.True(t, ok)
+	a := first.Managed.ConfigAutoMerge()
+	require.Equal(t, "off", a.Mode)
+	require.Equal(t, "fullsend-default", a.Policy)
+	require.Equal(t, []string{"OSPS-QA-03.01"}, *a.Controls)
+	other, ok := m.ResolveConfig("example", "docs")
+	require.True(t, ok)
+	require.Equal(t, "shadow", other.Managed.ConfigAutoMerge().Mode)
+	raw, err := m.Marshal()
+	require.NoError(t, err)
+	require.Contains(t, string(raw), "auto_merge:")
+}
