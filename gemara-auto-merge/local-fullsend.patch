+package cli
+
+import (
+	"bytes"
+	"context"
+	"github.com/fullsend-ai/fullsend/internal/ui"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAutoMergeConfigCommand(t *testing.T) {
+	for _, tc := range []struct {
+		yaml, want string
+		fail       bool
+	}{
+		{"auto_merge: {mode: shadow, controls: [OSPS-QA-03.01]}", `"mode":"shadow"`, false},
+		{"kill_switch: true\nauto_merge: {mode: enforce}", `"mode":"off"`, false},
+		{"auto_merge: {mode: typo}", "auto_merge.mode", true},
+	} {
+		dir := t.TempDir()
+		require.NoError(t, os.WriteFile(filepath.Join(dir, "config.yaml"), []byte(tc.yaml), 0600))
+		cmd := newAutoMergeCmd()
+		var b bytes.Buffer
+		cmd.SetOut(&b)
+		cmd.SetErr(&b)
+		cmd.SetArgs([]string{"config", "--config-dir", dir})
+		err := cmd.Execute()
+		if tc.fail {
+			require.ErrorContains(t, err, tc.want)
+		} else {
+			require.NoError(t, err)
+			require.Contains(t, b.String(), tc.want)
+		}
+	}
+	cmd := newAutoMergeCmd()
+	cmd.SetArgs([]string{"config", "--config-dir", filepath.Join(t.TempDir(), "absent")})
+	require.Error(t, cmd.Execute())
+}
+
+func TestRunAgentAutoMergeInvalidFailsBeforeSandbox(t *testing.T) {
+	usePreScriptStub(t)
+	dir := newSkipHarnessDir(t, "")
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "config.yaml"), []byte("agents:\n  - harness/code.yaml\nauto_merge: {mode: typo}\n"), 0600))
+	var b bytes.Buffer
+	err := runAgent(context.Background(), "code", dir, "", t.TempDir(), "", nil, false, "", "", "", resolveFlags{maxDepth: 10, maxResources: 50}, statusOpts{}, ui.New(&b), false, runOverrideFlags{})
+	require.ErrorContains(t, err, "auto_merge.mode")
+	require.NotContains(t, b.String(), "creating sandbox")
+}
