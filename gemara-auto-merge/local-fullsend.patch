@@ -0,0 +1,82 @@
+package config
+
+import (
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+	"testing"
+)
+
+func TestAutoMergeLayers(t *testing.T) {
+	base := []byte("auto_merge:\n  mode: enforce\n  policy: fullsend-default\n  controls: [OSPS-QA-03.01]\n")
+	c, err := ParsePerRepoConfigWriterLayered([]byte("auto_merge:\n  mode: off\n"), base)
+	require.NoError(t, err)
+	require.Equal(t, "off", c.ConfigAutoMerge().Mode)
+	require.Equal(t, []string{"OSPS-QA-03.01"}, *c.ConfigAutoMerge().Controls)
+	c, err = ParsePerRepoConfigWriterLayered([]byte("auto_merge:\n  controls: []\n"), base)
+	require.NoError(t, err)
+	require.Empty(t, *c.ConfigAutoMerge().Controls)
+	raw, err := c.Marshal()
+	require.NoError(t, err)
+	require.Contains(t, string(raw), "controls: []")
+	round, err := ParsePerRepoConfigWriterLayered(raw, base)
+	require.NoError(t, err)
+	require.Empty(t, *round.ConfigAutoMerge().Controls)
+	effective, err := EffectiveYAML(c)
+	require.NoError(t, err)
+	require.Contains(t, string(effective), "auto_merge:")
+}
+
+func TestAutoMergeValidation(t *testing.T) {
+	for _, block := range []string{"true", "{mode: yes}", "{mode: unsafe}", "{policy: arbitrary}", "{controls: [unknown]}", "{controls: [OSPS-QA-03.01, OSPS-QA-03.01]}", "{mod: enforce}", "{mode: off, mode: enforce}"} {
+		t.Run(block, func(t *testing.T) {
+			_, err := ParsePerRepoConfigWriter([]byte("auto_merge: " + block))
+			require.Error(t, err)
+		})
+	}
+	for _, a := range []AutoMergeConfig{{Mode: "bad"}, {Policy: "bad"}, {Controls: ptrControls("bad")}, {Controls: ptrControls("OSPS-QA-03.01", "OSPS-QA-03.01")}} {
+		c := NewEmptyPerRepoOverlay()
+		c.SetAutoMerge(a)
+		require.Error(t, c.Validate())
+	}
+	c := NewEmptyPerRepoOverlay()
+	require.Equal(t, "off", c.ConfigAutoMerge().Mode)
+	c.SetAutoMerge(AutoMergeConfig{Mode: "shadow"})
+	require.NoError(t, c.Validate())
+}
+
+func ptrControls(ids ...string) *[]string { return &ids }
+
+func TestAutoMergeManagedMergeAndClone(t *testing.T) {
+	var parent, child ManagedConfig
+	require.NoError(t, yaml.Unmarshal([]byte("auto_merge: {mode: shadow, controls: [OSPS-QA-03.01]}"), &parent))
+	require.NoError(t, yaml.Unmarshal([]byte("auto_merge: {mode: off}"), &child))
+	merged := MergeManaged(parent.Writer(), child.Writer())
+	a := merged.ConfigAutoMerge()
+	require.Equal(t, "off", a.Mode)
+	require.Equal(t, []string{"OSPS-QA-03.01"}, *a.Controls)
+	(*a.Controls)[0] = "changed"
+	require.Equal(t, "OSPS-QA-03.01", (*merged.ConfigAutoMerge().Controls)[0])
+	clone := parent.Clone()
+	require.Equal(t, "shadow", clone.Writer().ConfigAutoMerge().Mode)
+	(*clone.cfg.AutoMerge.Controls)[0] = "changed"
+	require.Equal(t, "OSPS-QA-03.01", (*parent.cfg.AutoMerge.Controls)[0])
+	require.Error(t, yaml.Unmarshal([]byte("auto_merge: {mdoe: shadow}"), &child))
+	require.NoError(t, yaml.Unmarshal([]byte("auto_merge: {controls: []}"), &child))
+	require.Empty(t, *MergeManaged(parent.Writer(), child.Writer()).ConfigAutoMerge().Controls)
+}
+
+func TestAutoMergeManagedSafety(t *testing.T) {
+	current := []byte("auto_merge: {mode: off, controls: [OSPS-QA-03.01]}")
+	preset := []byte("auto_merge: {mode: enforce, controls: []}")
+	rs, err := CheckManagedSafetyGateFromLayerPairs(current, nil, NewEmptyPerRepoOverlay(), preset)
+	require.NoError(t, err)
+	require.Equal(t, []string{"auto_merge.mode", "auto_merge.controls"}, SafetyRelaxationKeys(rs))
+	explicit, err := ParsePerRepoConfigWriter(preset)
+	require.NoError(t, err)
+	rs, err = CheckManagedSafetyGateFromLayerPairs(current, nil, explicit, preset)
+	require.NoError(t, err)
+	require.Empty(t, rs)
+	noChange := AutoMergeConfig{Mode: "off", Controls: ptrControls("OSPS-QA-03.01")}
+	require.Empty(t, autoMergeRelaxations(noChange, noChange, nil))
+	require.NotEmpty(t, autoMergeRelaxations(noChange, AutoMergeConfig{Mode: "off"}, nil))
+}
