index 00000000..7c71dacc
--- /dev/null
+++ b/internal/config/auto_merge.go
@@ -0,0 +1,122 @@
+package config
+
+import (
+	"fmt"
+	"gopkg.in/yaml.v3"
+	"slices"
+)
+
+// AutoMergeConfig selects the owner policy consumed by an auto-merge integration.
+// It does not grant forge permissions or create a merge writer. Nil controls
+// inherit; an explicit empty list clears optional controls.
+type AutoMergeConfig struct {
+	Mode     string    `yaml:"mode,omitempty" json:"mode"`
+	Policy   string    `yaml:"policy,omitempty" json:"policy"`
+	Controls *[]string `yaml:"controls,omitempty" json:"controls,omitempty"`
+}
+
+// UnmarshalYAML rejects misspelled security settings even on the runtime load path.
+func (a *AutoMergeConfig) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.MappingNode {
+		return fmt.Errorf("auto_merge must be a mapping")
+	}
+	for i := 0; i < len(n.Content); i += 2 {
+		if !slices.Contains([]string{"mode", "policy", "controls"}, n.Content[i].Value) {
+			return fmt.Errorf("unknown auto_merge field %q", n.Content[i].Value)
+		}
+	}
+	type plain AutoMergeConfig
+	var p plain
+	if err := n.Decode(&p); err != nil {
+		return err
+	}
+	*a = AutoMergeConfig(p)
+	return ValidateAutoMerge(*a)
+}
+
+// ValidateAutoMerge checks both sparse configuration layers and effective values.
+func ValidateAutoMerge(a AutoMergeConfig) error {
+	if !slices.Contains([]string{"", "off", "shadow", "enforce"}, a.Mode) {
+		return fmt.Errorf("auto_merge.mode must be off, shadow or enforce")
+	}
+	if a.Policy != "" && a.Policy != "fullsend-default" {
+		return fmt.Errorf("unsupported auto_merge.policy %q", a.Policy)
+	}
+	if a.Controls != nil {
+		seen := map[string]bool{}
+		for _, id := range *a.Controls {
+			if id != "OSPS-QA-03.01" {
+				return fmt.Errorf("unsupported auto_merge control %q", id)
+			}
+			if seen[id] {
+				return fmt.Errorf("duplicate auto_merge control %q", id)
+			}
+			seen[id] = true
+		}
+	}
+	return nil
+}
+
+func cloneAutoMerge(a *AutoMergeConfig) *AutoMergeConfig {
+	if a == nil {
+		return nil
+	}
+	out := *a
+	if a.Controls != nil {
+		v := append([]string{}, (*a.Controls)...)
+		out.Controls = &v
+	}
+	return &out
+}
+
+func mergeAutoMerge(parent, child *AutoMergeConfig) *AutoMergeConfig {
+	if parent == nil {
+		return cloneAutoMerge(child)
+	}
+	out := cloneAutoMerge(parent)
+	if child == nil {
+		return out
+	}
+	if child.Mode != "" {
+		out.Mode = child.Mode
+	}
+	if child.Policy != "" {
+		out.Policy = child.Policy
+	}
+	if child.Controls != nil {
+		out.Controls = cloneAutoMerge(child).Controls
+	}
+	return out
+}
+
+// ConfigAutoMerge resolves the block field by field through the parent chain.
+func (c *perRepoConfig) ConfigAutoMerge() AutoMergeConfig {
+	inherited := (&perRepoDefaults{}).ConfigAutoMerge()
+	if c.parent != nil {
+		inherited = c.parent.ConfigAutoMerge()
+	}
+	return *mergeAutoMerge(&inherited, c.AutoMerge)
+}
+
+// SetAutoMerge updates only this layer, retaining explicit empty control lists.
+func (c *perRepoConfig) SetAutoMerge(a AutoMergeConfig) { c.AutoMerge = cloneAutoMerge(&a) }
+
+func autoMergeRelaxations(current, candidate AutoMergeConfig, local *perRepoConfig) []SafetyRelaxation {
+	var declared *AutoMergeConfig
+	if local != nil {
+		declared = local.AutoMerge
+	}
+	var out []SafetyRelaxation
+	if candidate.Mode == "enforce" && current.Mode != "enforce" && (declared == nil || declared.Mode != "enforce") {
+		out = append(out, SafetyRelaxation{Key: "auto_merge.mode", Current: current.Mode, Candidate: candidate.Mode})
+	}
+	if current.Controls != nil {
+		for _, id := range *current.Controls {
+			removed := candidate.Controls == nil || !slices.Contains(*candidate.Controls, id)
+			if removed && (declared == nil || declared.Controls == nil) {
+				out = append(out, SafetyRelaxation{Key: "auto_merge.controls", Current: id, Candidate: "removed"})
+			}
+		}
+	}
+	return out
+}
