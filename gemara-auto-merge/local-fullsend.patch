+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/fullsend-ai/fullsend/internal/config"
+	"github.com/spf13/cobra"
+)
+
+func newAutoMergeCmd() *cobra.Command {
+	var dir string
+	cmd := &cobra.Command{Use: "auto-merge", Short: "Inspect auto-merge policy configuration (experimental)"}
+	show := &cobra.Command{Use: "config", Short: "Print validated effective auto-merge settings as JSON", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			reader, err := config.LoadConfig(dir, config.LoadOpts{})
+			if err != nil {
+				return err
+			}
+			repo, ok := reader.(config.PerRepoConfigReader)
+			if !ok {
+				return fmt.Errorf("per-repository configuration required")
+			}
+			a := repo.ConfigAutoMerge()
+			if err := config.ValidateAutoMerge(a); err != nil {
+				return err
+			}
+			if repo.IsKillSwitchActive() {
+				a.Mode = "off"
+			}
+			return json.NewEncoder(cmd.OutOrStdout()).Encode(a)
+		}}
+	show.Flags().StringVar(&dir, "config-dir", ".fullsend", "Directory containing trusted config.yaml and optional config.base.yaml")
+	cmd.AddCommand(show)
+	return cmd
+}
