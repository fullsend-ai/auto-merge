--- a/scripts/post-review.sh
+++ b/scripts/post-review.sh
@@ -2084,0 +2085,25 @@
+# Runner-owned revision-bound risk projection; never copy model receipt markers.
+# The observer verifies this run and its trusted configuration before using risk.
+RISK_PROJECTION="$(jq -c \
+  --arg config "${GITHUB_SHA:-}" \
+  --arg run "${GITHUB_RUN_ID:-}" \
+  --arg attempt "${GITHUB_RUN_ATTEMPT:-}" '
+
+  .head_sha as $head
+  | .risk_assessment
+  | select(type == "object" and (has("degraded") | not))
+  | select(.score | type == "number" and floor == . and . >= 1 and . <= 5)
+  | select(.level == (["low", "moderate", "elevated", "high", "critical"][.score - 1]))
+  | select($head | type == "string" and test("^[0-9a-f]{40}$"))
+  | select($config | test("^[0-9a-f]{40}$"))
+  | select($run | test("^[1-9][0-9]{0,14}$"))
+  | select($attempt | test("^[1-9][0-9]{0,5}$"))
+  | {version: 1, head_sha: $head, score, level,
+     config_sha: $config, run_id: ($run | tonumber), run_attempt: ($attempt | tonumber)}
+
+' "${RESULT_FILE}")"
+RISK_PROJECTION_MARKER=""
+if [[ -n "${RISK_PROJECTION}" ]]; then
+  RISK_ENCODED="$(printf '%s' "${RISK_PROJECTION}" | base64 | tr -d '\n')"
+  RISK_PROJECTION_MARKER="<!-- fullsend:review-risk-v1:${RISK_ENCODED} -->"
+fi
@@ -2087 +2112 @@
-jq --arg marker "${PROJECTION_MARKER}" '
+jq --arg marker "${PROJECTION_MARKER}" --arg risk_marker "${RISK_PROJECTION_MARKER}" '
@@ -2091,0 +2117 @@
+    | gsub("(?m)^<!-- fullsend:review-risk-v[0-9]+:[A-Za-z0-9+/=]+ -->\\r?$"; "")
@@ -2104,0 +2131 @@
+  | if $risk_marker == "" then . else .body = ($risk_marker + "\n\n" + .body) end
@@ -2140,0 +2168,3 @@
+
+# The forge post succeeded for the exact head. Only the trusted host publishes.
+printf '%s' "${PRIOR_FINDINGS_PROJECTION}" | python3 "${FULLSEND_NATIVE_PUBLISHER:?}" "${RESULT_FILE}"
